<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>PCU Event Approval Workflow — Demo</title><style>
:root{--m:#941c34;--dark:#6e1426;--bg:#f4f6f9;--line:#e1e5eb;--muted:#687080;--green:#167746}*{box-sizing:border-box}body{margin:0;background:var(--bg);font:14px Arial,sans-serif;color:#242832}header{background:linear-gradient(110deg,var(--dark),var(--m));color:white;padding:17px 24px;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}.brand{display:flex;align-items:center;gap:12px}.crest{border:2px solid #fff9;border-radius:50%;width:45px;height:45px;display:grid;place-items:center;font-weight:bold}.brand h1{font-size:19px;margin:0 0 4px}.brand p{font-size:12px;margin:0;opacity:.85}.rolebox{display:flex;align-items:center;gap:9px;flex-wrap:wrap}.rolebox select{padding:10px;border-radius:8px;border:0}.tag{border:1px solid #ffffff8a;padding:6px 9px;border-radius:20px;font-size:10px}.layout{display:grid;grid-template-columns:220px 1fr;min-height:calc(100vh - 80px)}aside{background:white;border-right:1px solid var(--line);padding:17px 12px}.nav{display:block;width:100%;border:0;background:white;text-align:left;padding:12px;border-radius:8px;margin:3px 0;cursor:pointer;color:#414652}.nav.active,.nav:hover{background:#f8e9ed;color:var(--m);font-weight:bold}.navlabel{font-size:10px;color:#89909b;letter-spacing:1px;padding:7px 12px}main{padding:24px;max-width:1450px;width:100%;margin:auto}.page{display:none}.page.active{display:block}.head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:20px;flex-wrap:wrap}.head h2{margin:0 0 6px;font-size:24px}.head p{margin:0;color:var(--muted)}.btn{border:0;border-radius:8px;padding:10px 14px;font-weight:bold;cursor:pointer;font-size:12px}.primary{background:var(--m);color:white}.secondary{background:white;border:1px solid var(--line);color:#333}.green{background:var(--green);color:white}.danger{background:#fff0f1;color:#a32034;border:1px solid #f0c5cc}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:17px}.stat,.panel{background:white;border:1px solid var(--line);border-radius:11px;padding:17px;box-shadow:0 2px 5px #11100005}.stat small{color:var(--muted)}.stat strong{display:block;font-size:28px;margin:9px 0}.grid2{display:grid;grid-template-columns:1.3fr .7fr;gap:16px}.panel h3{font-size:16px;margin:0 0 14px}.notice{padding:12px 14px;border-radius:8px;background:#fff7e8;border:1px solid #f1dfb6;color:#76521b;font-size:12px;line-height:1.5;margin-bottom:16px}.steps{display:grid;gap:9px}.step{display:flex;gap:10px;border:1px solid var(--line);padding:11px;border-radius:8px}.dot{width:26px;height:26px;flex:none;border-radius:50%;display:grid;place-items:center;background:#edf0f4;font-weight:bold;font-size:12px}.step.done .dot{background:#dff4e7;color:#167746}.step.current{border-color:#d9a1ad;background:#fff8fa}.step.current .dot{background:var(--m);color:white}.step b{font-size:13px}.step small{display:block;color:var(--muted);font-size:11px;margin-top:4px;line-height:1.4}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.field{display:flex;flex-direction:column;gap:6px}.field.full{grid-column:1/-1}.field label{font-size:12px;font-weight:bold;color:#4b5563}.field input,.field select,.field textarea{border:1px solid #d6dae1;border-radius:7px;padding:10px;font:inherit;width:100%}.field textarea{min-height:100px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.hint,.small{color:var(--muted);font-size:11px;line-height:1.5}.tablewrap{overflow:auto}table{border-collapse:collapse;width:100%;font-size:12px}th,td{text-align:left;padding:11px 9px;border-bottom:1px solid #eceef2;white-space:nowrap}th{background:#f8f8fa;color:#687080;font-size:10px;text-transform:uppercase}td.wrap{white-space:normal;min-width:170px}.badge{display:inline-block;border-radius:20px;padding:5px 8px;font-size:10px;font-weight:bold;background:#eef0f3}.pending{background:#fff2d9;color:#8b5a09}.approved{background:#e4f6eb;color:#167242}.returned{background:#ffebee;color:#a32034}.review{background:#e8efff;color:#2855a0}.empty{text-align:center;padding:25px;color:var(--muted)}.approvalbox{border:1px solid var(--line);border-radius:9px;padding:14px;margin-bottom:12px}.approvalbox h4{margin:0}.topline{display:flex;justify-content:space-between;align-items:center;gap:10px}.search{padding:10px;border:1px solid var(--line);border-radius:7px}.doc{font-family:Arial,sans-serif;background:white;color:#111;max-width:850px;margin:auto;border:1px solid #555;padding:8px 12px;position:relative}.dochead{display:grid;grid-template-columns:65px 1fr 55px;align-items:center;text-align:center;border-bottom:2px solid #333;padding:5px 0 8px}.seal{width:43px;height:43px;border:2px solid #8b1e36;border-radius:50%;display:grid;place-items:center;color:#8b1e36;font-size:9px;font-weight:bold;margin:auto}.dochead strong{display:block;font-family:Georgia,serif;font-size:17px;color:#8b1e36}.dochead small{display:block;font-size:8px;line-height:1.4}.docrow{display:grid;grid-template-columns:1fr 1fr;border:1px solid #444;min-height:27px}.docrow>div{padding:6px 8px;font-size:11px;border-right:1px solid #555}.docrow>div:last-child{border:0}.docrow.titlebar{font-weight:bold;text-align:center}.subject{border:1px solid #444;padding:7px 9px;font-size:11px;font-weight:bold}.docbody{border:1px solid #444;padding:10px;min-height:165px;font-size:11px;line-height:1.7;white-space:pre-wrap}.budget{display:grid;grid-template-columns:1.2fr 1fr 1fr;border:1px solid #555;margin:0 10px 15px}.budget div{padding:7px 6px;border-right:1px solid #777;font-size:9px;min-height:38px}.budget div:last-child{border:0}.signs{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin:20px 4px 5px;text-align:center;min-height:100px;align-items:end}.signature{height:34px;color:#2458a6;font-family:'Brush Script MT','Segoe Script',cursive;font-size:18px;font-style:italic;padding-top:8px}.signlabel{font-size:10px;font-weight:bold}.signsub{font-size:9px;margin-top:4px}.watermark{text-align:center;color:#b91c1c;opacity:.45;font-weight:bold;letter-spacing:3px;font-size:12px;padding:6px;border:1px dashed #c66;margin:0 0 8px}.modalback{display:none;position:fixed;inset:0;background:#1119;z-index:5;align-items:center;justify-content:center;padding:18px}.modalback.show{display:flex}.modal{background:white;border-radius:12px;padding:22px;max-width:520px;width:100%}.modal h3{margin-top:0}.modal textarea{width:100%;min-height:80px;padding:10px;border:1px solid var(--line);border-radius:8px}@media(max-width:850px){.layout{grid-template-columns:1fr}aside{display:flex;overflow:auto;padding:8px}.navlabel{display:none}.nav{white-space:nowrap;width:auto}.stats{grid-template-columns:repeat(2,1fr)}.grid2{grid-template-columns:1fr}main{padding:14px}}@media(max-width:520px){.formgrid{grid-template-columns:1fr}.field.full{grid-column:auto}.dochead strong{font-size:12px}.signs{grid-template-columns:1fr 1fr}}@media print{body{background:white}header,aside,.no-print,footer{display:none!important}.layout{display:block}.layout main{padding:0;max-width:none}.page{display:none!important}#document{display:block!important}.panel{border:0;box-shadow:none;padding:0}.doc{max-width:none;border:0;padding:4mm 5mm}@page{size:A4;margin:10mm}}
</style></head><body>
<header><div class="brand"><div class="crest">PCU</div><div><h1>PCU Event Approval Workflow</h1><p>Pimpri Chinchwad University · Demonstration Prototype</p></div></div><div class="rolebox"><span class="tag">DEMO DATA ONLY</span><label for="role">View as</label><select id="role"><option>Faculty</option><option>HOD</option><option>Registrar Assistant</option><option>Academic Dean</option><option>Registrar</option><option>Vice-Chancellor</option><option>Administrator</option></select></div></header>
<div class="layout"><aside><div class="navlabel">WORKSPACE</div><button class="nav active" data-page="dashboard">▦ &nbsp; Dashboard</button><button class="nav" data-page="new">＋ &nbsp; New Proposal</button><button class="nav" data-page="desk">▤ &nbsp; Approval Desk</button><button class="nav" data-page="records">◷ &nbsp; Proposal Records</button><button class="nav" data-page="document">▧ &nbsp; Approval Document</button></aside><main>
<section class="page active" id="dashboard"><div class="head"><div><h2>Dashboard</h2><p>Track event proposals through the university approval chain.</p></div><button class="btn primary" onclick="page('new')">＋ Create Proposal</button></div><div class="notice"><b>Demonstration mode:</b> Use the role selector to act as each desk. Sample signature marks are placeholders, not real officials' signatures. Data is stored only in this browser.</div><div class="stats"><div class="stat"><small>Total Proposals</small><strong id="total">0</strong><small>Local demo records</small></div><div class="stat"><small>Awaiting Selected Desk</small><strong id="pending">0</strong><small>Based on selected role</small></div><div class="stat"><small>Fully Approved</small><strong id="approved">0</strong><small>Ready for PDF print</small></div><div class="stat"><small>Returned</small><strong id="returned">0</strong><small>Needs correction</small></div></div><div class="grid2"><div class="panel"><div class="topline"><h3>Recent Proposals</h3><button class="btn secondary" onclick="page('records')">View all</button></div><div id="recent" class="tablewrap"></div></div><div class="panel"><h3>Approval Workflow</h3><div class="steps" id="steps"></div></div></div></section>
<section class="page" id="new"><div class="head"><div><h2>New Event Approval Proposal</h2><p>Fill in the information for the PCU Note for Approval format.</p></div></div><div class="notice">Use sample information for this demonstration. Required fields are marked with *.</div><div class="grid2"><div class="panel"><h3>Proposal Information</h3><form id="form"><div class="formgrid"><div class="field"><label>School / Department *</label><input name="department" required value="School of Computer Science — CSE AI&ML"></div><div class="field"><label>Proposal Date *</label><input name="proposalDate" type="date" required></div><div class="field full"><label>Subject / Event Title *</label><input name="subject" required placeholder="e.g. National-Level AI Symposium"></div><div class="field"><label>Event Date *</label><input name="eventDate" type="date" required></div><div class="field"><label>Venue *</label><input name="venue" required placeholder="Auditorium, Admin Block"></div><div class="field"><label>Initiated By *</label><input name="initiatedBy" required value="Demo Faculty Member"></div><div class="field"><label>Designation *</label><input name="designation" required value="Assistant Professor"></div><div class="field full"><label>Proposal Details *</label><textarea name="body" required placeholder="Purpose, objectives, participants and expected outcomes..."></textarea></div><div class="field"><label>Budget Head</label><input name="budgetHead" value="Academic / Event Activities"></div><div class="field"><label>Allocated Amount (₹)</label><input name="allocated" type="number" min="0" value="25000"></div><div class="field"><label>Budget Used (₹)</label><input name="used" type="number" min="0" value="0"></div><div class="field"><label>Balance Budget (₹)</label><input name="balance" type="number" min="0" value="25000"></div></div><div class="actions"><button class="btn primary">Submit Proposal for Approval →</button><button class="btn secondary" type="reset">Clear Form</button></div></form></div><div class="panel"><h3>Approval Route</h3><p class="small">Each desk can approve and forward, or return the proposal with correction notes.</p><div class="steps" id="newsteps"></div><div class="notice" style="margin-top:14px">The Registrar Assistant verifies format and information. The final layout retains the signature areas shown in the supplied reference; HOD and Registrar Assistant decisions are preserved in the workflow history.</div></div></div></section>
<section class="page" id="desk"><div class="head"><div><h2>Approval Desk</h2><p>Items waiting for the selected role.</p></div><span id="desklabel" class="badge review">Faculty</span></div><div class="panel"><div id="deskcontent"></div></div></section>
<section class="page" id="records"><div class="head"><div><h2>Proposal Records</h2><p>Search and review demo records by event, department, date or status.</p></div><button class="btn secondary" onclick="csv()">Export Records CSV</button></div><div class="panel"><div class="topline"><input class="search" id="search" placeholder="Search proposals…" oninput="renderRecords()"><select id="year" onchange="renderRecords()"><option value="">All years</option></select></div><div id="recordtable" class="tablewrap"></div><div id="admincontrols"></div></div></section>
<section class="page" id="document"><div class="head no-print"><div><h2>Approval Document Preview</h2><p>Print and choose “Save as PDF” in the browser print dialog.</p></div><div class="actions" style="margin:0"><button class="btn secondary" onclick="page('records')">Back to Records</button><button class="btn primary" onclick="window.print()">Download / Print PDF</button></div></div><div id="docnotice" class="notice no-print"></div><div class="panel"><div id="docmount"></div></div></section><footer style="text-align:center;color:#9298a3;font-size:11px;padding:20px">PCU Event Approval Workflow · Prototype for demonstration · Not an official university system</footer></main></div>
<div class="modalback" id="modal"><div class="modal"><h3 id="modtitle">Review Proposal</h3><p id="moddesc" class="small">Confirm your action.</p><label for="comment"><b>Review comment</b> (required when returning)</label><textarea id="comment" placeholder="Add approval note or correction required…"></textarea><div class="actions"><button class="btn secondary" onclick="closeModal()">Cancel</button><button class="btn danger" onclick="act('return')">Return for Correction</button><button class="btn primary" onclick="act('approve')">Approve & Forward →</button></div></div></div>
<script>
const FLOW=[['HOD','HOD Desk','Departmental review'],['Registrar Assistant','Registrar Assistant Desk','Format and information verification'],['Academic Dean','Academic Dean Desk','Academic review and approval'],['Registrar','Registrar Desk','Registrar review and approval'],['Vice-Chancellor','Vice-Chancellor Desk','Final approval']];const USERS={'Faculty':'Demo Faculty Member','HOD':'Demo HOD','Registrar Assistant':'Demo Registrar Assistant','Academic Dean':'Demo Academic Dean','Registrar':'Demo Registrar','Vice-Chancellor':'Demo Vice-Chancellor','Administrator':'Demo Administrator'};const KEY='pcu_event_approval_demo_v1';let role='Faculty',items=[],selected=null;
const today=()=>new Date().toISOString().slice(0,10),fmt=d=>d?new Date(d+'T00:00:00').toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}):'—',money=n=>'₹'+Number(n||0).toLocaleString('en-IN'),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function save(){localStorage.setItem(KEY,JSON.stringify(items))}function log(p,r,a,c=''){p.history.push({role:r,actor:USERS[r]||r,action:a,comment:c,at:new Date().toISOString()})}function desk(p){return p.status==='Approved'?'Approved':p.status==='Returned'?'Returned':p.stage===0?'Faculty Desk':FLOW[Math.min(p.stage-1,4)][1]}function badge(s){return `<span class="badge ${s==='Approved'?'approved':s==='Returned'?'returned':s==='Pending'?'pending':'review'}">${esc(s)}</span>`}
function init(){items=JSON.parse(localStorage.getItem(KEY)||'[]');if(!items.length){let p={id:'PCU-EVT-'+new Date().getFullYear()+'-0001',department:'School of Computer Science — CSE AI&ML',proposalDate:today(),eventDate:new Date(Date.now()+14*864e5).toISOString().slice(0,10),subject:'National-Level AI-Driven DevOps Symposium',venue:'Admin Block Auditorium, 3rd Floor',initiatedBy:USERS.Faculty,designation:'Assistant Professor',body:'Approval is requested to organize a national-level symposium on AI-Driven DevOps: Engineering the Future. The event will provide a platform for students, researchers and industry professionals to discuss emerging practices, share knowledge and explore practical applications.',budgetHead:'Academic / Event Activities',allocated:25000,used:0,balance:25000,status:'Pending',stage:1,createdAt:new Date().toISOString(),history:[]};log(p,'Faculty','Submitted','Sample proposal submitted to HOD Desk.');items=[p];save()}document.querySelector('[name=proposalDate]').value=today();renderAll()}
function page(n){document.querySelectorAll('.page').forEach(x=>x.classList.toggle('active',x.id===n));document.querySelectorAll('.nav').forEach(x=>x.classList.toggle('active',x.dataset.page===n));if(n==='dashboard')renderDash();if(n==='desk')renderDesk();if(n==='records')renderRecords();if(n==='document')renderDoc()}document.querySelectorAll('.nav').forEach(b=>b.onclick=()=>page(b.dataset.page));document.getElementById('role').onchange=e=>{role=e.target.value;renderAll()};document.getElementById('form').onsubmit=e=>{e.preventDefault();if(!['Faculty','Administrator'].includes(role)){alert('Switch to Faculty or Administrator role to create a proposal.');return}let p=Object.fromEntries(new FormData(e.target));p.allocated=+p.allocated||0;p.used=+p.used||0;p.balance=+p.balance||0;p.id='PCU-EVT-'+new Date().getFullYear()+'-'+String(Math.max(0,...items.map(x=>+x.id.split('-').pop()||0))+1).padStart(4,'0');p.status='Pending';p.stage=1;p.createdAt=new Date().toISOString();p.history=[];log(p,'Faculty','Submitted','Proposal submitted to HOD Desk.');items.unshift(p);selected=p.id;save();alert('Proposal submitted. Reference: '+p.id+'\nCurrent desk: HOD Desk');e.target.reset();document.querySelector('[name=proposalDate]').value=today();page('desk')};
function renderSteps(id,p=null){document.getElementById(id).innerHTML=FLOW.map((s,i)=>{let done=p&&(p.status==='Approved'||i<p.stage-1),cur=p&&p.status==='Pending'&&i===p.stage-1;return `<div class="step ${done?'done':''} ${cur?'current':''}"><div class="dot">${done?'✓':i+1}</div><div><b>${s[1]}</b><small>${s[2]}${cur?' · Awaiting action':done?' · Completed':''}</small></div></div>`}).join('')}
function table(list){return `<table><thead><tr><th>Reference</th><th>Event / Subject</th><th>Proposal Date</th><th>Current Desk</th><th>Status</th><th>Action</th></tr></thead><tbody>${list.map(p=>`<tr><td>${esc(p.id)}</td><td class="wrap"><b>${esc(p.subject)}</b><br><span class="small">${esc(p.department)}</span></td><td>${fmt(p.proposalDate)}</td><td>${esc(desk(p))}</td><td>${badge(p.status)}</td><td><button class="btn secondary" onclick="view('${p.id}')">View</button></td></tr>`).join('')}</tbody></table>`}
function renderDash(){document.getElementById('total').textContent=items.length;document.getElementById('pending').textContent=items.filter(p=>role==='Administrator'?p.status==='Pending':role==='Faculty'?p.initiatedBy===USERS.Faculty&&p.status==='Pending':p.status==='Pending'&&FLOW[p.stage-1]?.[0]===role).length;document.getElementById('approved').textContent=items.filter(p=>p.status==='Approved').length;document.getElementById('returned').textContent=items.filter(p=>p.status==='Returned').length;document.getElementById('recent').innerHTML=items.length?table(items.slice(0,5)):'<div class="empty">No proposals yet.</div>';renderSteps('steps')}
function renderDesk(){document.getElementById('desklabel').textContent=role+' Desk';let list=items.filter(p=>role==='Administrator'?p.status!=='Approved':role==='Faculty'?p.initiatedBy===USERS.Faculty: p.status==='Pending'&&FLOW[p.stage-1]?.[0]===role);let out=list.map(p=>{let can=!['Faculty','Administrator'].includes(role)&&p.status==='Pending'&&FLOW[p.stage-1]?.[0]===role;return `<div class="approvalbox"><div class="topline"><h4>${esc(p.subject)}</h4>${badge(p.status)}</div><p class="small"><b>${esc(p.id)}</b> · ${esc(p.department)}<br>Event date: ${fmt(p.eventDate)} · Venue: ${esc(p.venue)}<br>Current desk: <b>${esc(desk(p))}</b></p><div class="actions"><button class="btn secondary" onclick="view('${p.id}')">View Details / History</button>${can?`<button class="btn primary" onclick="review('${p.id}')">Review Proposal →</button>`:''}${p.status==='Approved'?`<button class="btn secondary" onclick="selectDoc('${p.id}')">View Approval PDF</button>`:''}</div></div>`}).join('');document.getElementById('deskcontent').innerHTML=out||'<div class="empty">No proposals waiting for this desk. Change the role selector to demonstrate the next stage.</div>'}
function view(id){selected=id;let p=items.find(x=>x.id===id);let hist=p.history.map(h=>`<div class="step done"><div class="dot">✓</div><div><b>${esc(h.action)} — ${esc(h.role)}</b><small>${esc(h.actor)} · ${new Date(h.at).toLocaleString()}${h.comment?'<br>'+esc(h.comment):''}</small></div></div>`).join('');document.getElementById('deskcontent').innerHTML=`<div class="approvalbox"><div class="topline"><h4>${esc(p.subject)}</h4>${badge(p.status)}</div><p class="small"><b>Reference:</b> ${esc(p.id)}<br><b>Department:</b> ${esc(p.department)}<br><b>Event:</b> ${fmt(p.eventDate)} · ${esc(p.venue)}<br><b>Initiated by:</b> ${esc(p.initiatedBy)} (${esc(p.designation)})<br><b>Budget:</b> ${money(p.allocated)} allocated · ${money(p.used)} used · ${money(p.balance)} balance</p><p>${esc(p.body)}</p><div class="actions"><button class="btn secondary" onclick="renderDesk()">← Back</button><button class="btn secondary" onclick="selectDoc('${p.id}')">Preview Approval Format</button></div></div><div class="panel"><h3>Approval History</h3><div class="steps">${hist}</div></div>`;page('desk')}
function review(id){selected=id;document.getElementById('modtitle').textContent='Review and approve proposal';document.getElementById('moddesc').textContent='Approval records your demo signature acknowledgement and forwards the proposal to the next desk.';document.getElementById('comment').value='';document.getElementById('modal').classList.add('show')}function closeModal(){document.getElementById('modal').classList.remove('show')}function act(action){let p=items.find(x=>x.id===selected),c=document.getElementById('comment').value.trim();if(action==='return'&&!c){alert('Please enter the correction required.');return}if(action==='return'){p.status='Returned';p.returnedStage=p.stage;log(p,role,'Returned for Correction',c);alert('Proposal returned with comments. Administrator can resume it for demonstration.')}else{log(p,role,'Approved & Signed',c||'Approved using demo signature acknowledgement.');if(p.stage>=FLOW.length){p.status='Approved';p.stage=FLOW.length+1;p.approvedAt=new Date().toISOString();alert('Final approval recorded. The proposal is ready for PDF preview/print.')}else{p.stage++;alert('Approved. Forwarded to '+FLOW[p.stage-1][1]+'.')}}save();closeModal();renderAll();renderDesk()}
function renderRecords(){let q=(document.getElementById('search')?.value||'').toLowerCase(),sel=document.getElementById('year'),years=[...new Set(items.map(p=>(p.proposalDate||'').slice(0,4)))];if(sel.options.length!==years.length+1)sel.innerHTML='<option value="">All years</option>'+years.map(y=>`<option>${esc(y)}</option>`).join('');let y=sel.value;let list=items.filter(p=>(role==='Administrator'||role!=='Faculty'||p.initiatedBy===USERS.Faculty)&&(!y||(p.proposalDate||'').startsWith(y))&&[p.id,p.subject,p.department,p.initiatedBy,desk(p),p.status].join(' ').toLowerCase().includes(q));document.getElementById('recordtable').innerHTML=list.length?table(list):'<div class="empty">No matching records.</div>';document.getElementById('admincontrols').innerHTML=role==='Administrator'?'<div class="actions"><button class="btn secondary" onclick="resumeReturned()">Resume Returned Proposals at HOD</button><button class="btn danger" onclick="resetDemo()">Reset Sample Data</button></div>':''}
function selectDoc(id){selected=id;page('document')}function sign(roleName,p){let h=p.history.find(x=>x.role===roleName&&x.action==='Approved & Signed');return h?`<div class="signature">Demo signed</div><div class="signlabel">${roleName==='Academic Dean'?'Dean Academics':roleName==='Vice-Chancellor'?'Vice Chancellor':esc(roleName)}</div><div class="signsub">${new Date(h.at).toLocaleDateString('en-IN')} · DEMO</div>`:`<div class="signature"></div><div class="signlabel">${roleName==='Academic Dean'?'Dean Academics':roleName==='Vice-Chancellor'?'Vice Chancellor':esc(roleName)}</div><div class="signsub">${p.status==='Approved'?'Approval recorded':'Pending approval'}</div>`}
function renderDoc(){let p=items.find(x=>x.id===selected)||items.find(x=>x.status==='Approved')||items[0];if(!p){document.getElementById('docmount').innerHTML='<div class="empty">Create a proposal first.</div>';return}document.getElementById('docnotice').innerHTML=p.status==='Approved'?'<b>Approved demo record.</b> Print and select Save as PDF. This is still a demonstration document.':'<b>Preview only — not finally approved.</b> The document is watermarked DEMO. Final approval PDF is enabled only after all required stages.';document.getElementById('docmount').innerHTML=`<div class="doc"><div class="watermark">DEMO COPY · NOT FOR OFFICIAL USE</div><div class="dochead"><div class="seal">PCU<br>EST. 2016</div><div><small>Pimpri Chinchwad Education Trust's</small><strong>PIMPRI CHINCHWAD UNIVERSITY</strong><small>Learn | Create | Inspire · Pune, Maharashtra</small></div><div class="seal">PCU</div></div><div class="docrow titlebar"><div>NOTE FOR APPROVAL</div><div>School / Department: ${esc(p.department)}</div></div><div class="docrow"><div><b>Reference No.</b> ${esc(p.id)}</div><div><b>Date:</b> ${fmt(p.proposalDate)}</div></div><div class="subject">Subject: ${esc(p.subject)}</div><div class="docbody"><b>Respected Madam / Sir,</b><br><br>${esc(p.body)}<br><br><b>Event Date:</b> ${fmt(p.eventDate)} &nbsp;&nbsp; <b>Venue:</b> ${esc(p.venue)}<br><br><b>Initiated By:</b> ${esc(p.initiatedBy)}<br><br><b>Designation:</b> ${esc(p.designation)}</div><div class="budget"><div><b>Budget Head & Allocated Amount:</b><br>${esc(p.budgetHead||'—')}<br>${money(p.allocated)}</div><div><b>Budget Used:</b><br>${money(p.used)}</div><div><b>Balance Budget:</b><br>${money(p.balance)}</div></div><div class="signs"><div>${sign('Academic Dean',p)}</div><div><div class="signature">${p.status==='Approved'?'Demo submitted':''}</div><div class="signlabel">Submitted by</div><div class="signsub">${esc(p.initiatedBy)}</div></div><div>${sign('Registrar',p)}</div><div>${sign('HOD',p)}</div><div>${sign('Registrar Assistant',p)}</div><div>${sign('Vice-Chancellor',p)}</div></div><div style="border-top:1px solid #777;margin-top:12px;padding:6px;text-align:center;font-size:8px">PCU Event Approval Workflow · Demonstration copy · Not valid for official use</div></div>`}
function csv(){let rows=[['Reference','Subject','Department','Proposal Date','Event Date','Current Desk','Status','Initiated By'],...items.map(p=>[p.id,p.subject,p.department,p.proposalDate,p.eventDate,desk(p),p.status,p.initiatedBy])];let s=rows.map(r=>r.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\r\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob([s],{type:'text/csv;charset=utf-8'}));a.download='PCU_Event_Approval_Demo_Records.csv';a.click();URL.revokeObjectURL(a.href)}function resumeReturned(){let n=0;items.forEach(p=>{if(p.status==='Returned'){p.status='Pending';p.stage=1;log(p,'Administrator','Resubmitted to HOD','Demo reset to continue workflow.');n++}});save();renderAll();alert(n+' returned proposal(s) resumed at HOD Desk.')}function resetDemo(){if(confirm('Reset all local demo records to the original sample proposal?')){localStorage.removeItem(KEY);init()}}function renderAll(){renderDash();renderDesk();renderRecords();renderSteps('newsteps');renderDoc()}init();
</script></body></html>
